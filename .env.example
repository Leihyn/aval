# Aval — credentials manifest
#
# WAVE 1 REQUIRES ZERO CREDENTIALS. This is a deliberate design decision, not an
# oversight: a judge clones the repo and runs `npm test` with no keys, no wallet,
# no RPC endpoint and no Docker. Everything below is Wave 2 scope and is NOT read
# by any code that currently exists.

# ── Wave 1: nothing required ──────────────────────────────────────────────────
# (intentionally empty)

# ── Wave 2: real source-chain attestor (NOT BUILT YET) ────────────────────────
# Ethereum JSON-RPC the attestor watcher will listen on for Locked events.
# Obtain from: https://dashboard.alchemy.com or any RPC provider.
# SOURCE_RPC_URL=placeholder_value

# Address of the source-chain escrow contract emitting Locked(...).
# Obtain from: your own deployment.
# SOURCE_ESCROW_ADDRESS=placeholder_value

# Attestor signing key. Wave 2 only. Never commit a real value.
# Obtain from: generated at attestor setup.
# ATTESTOR_PRIVATE_KEY=generated_at_deploy

# ── Deploy only (frontend hosting) ────────────────────────────────────────────
# Obtain from: https://vercel.com/account/tokens
# VERCEL_TOKEN=placeholder_value
