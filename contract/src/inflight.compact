pragma language_version >= 0.26;
import CompactStandardLibrary;

export ledger attestations: HistoricMerkleTree<10, Bytes<32>>;
export ledger spent: Set<Bytes<32>>;
export ledger fills: Counter;

witness find_path(leaf: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness get_amount(): Uint<64>;
witness get_lock_id(): Bytes<32>;
witness get_salt(): Bytes<32>;

export circuit prove_funds_in_flight(required: Uint<64>, counterparty: Bytes<32>): [] {
  const amt  = get_amount();
  const lid  = get_lock_id();
  const salt = get_salt();

  const leaf = persistentHash<Vector<4, Bytes<32>>>(
    [lid, (amt as Field) as Bytes<32>, counterparty, salt]);
  const path = find_path(leaf);

  const root = disclose(merkleTreePathRoot<10, Bytes<32>>(path));
  assert(attestations.checkRoot(root), "attestation not in tree");
  assert(disclose(amt >= required), "insufficient funds in flight");

  const nul = disclose(persistentHash<Vector<3, Bytes<32>>>([pad(32,"nul:v1"), lid, salt]));
  assert(!spent.member(nul), "attestation already spent");
  spent.insert(nul);
  fills.increment(1);
}
